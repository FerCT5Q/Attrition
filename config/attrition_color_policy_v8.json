{
  "policy_id": "v8-comparable-and-within-panel-attrition-colors-20260929",
  "version": 3,
  "deliverable_mode": "internal_analysis",
  "purpose": "Classify visible attrition-rate pills against a pooled comparable cohort when available; otherwise rank published numeric rates within the same chart panel.",
  "calculation": {
    "reference_formula": "100 * voluntary_exit_count / eligible_baseline_count",
    "rate_precision": "Use the evidence value before reader-facing rounding.",
    "relative_materiality": 0.2,
    "absolute_materiality_percentage_points": 0.5,
    "zero_reference_rule": "Zero-rate categories are blue; a nonzero category is orange only at or above 0.5 percentage points. Green is not applicable below a zero reference.",
    "fallback_within_panel_rule": "When no pooled comparable reference is validated but a chart panel already publishes numeric attrition rates, its lowest rate is green, its highest rate is orange, and intervening rates are blue. Rates that are not estimable or have a baseline cohort below 30 remain gray.",
    "fallback_color_scope": "Within one chart panel only; fallback colors are not comparable across panels or slides."
  },
  "display": {
    "rate_decimal_places": 1,
    "positive_value_below_display_precision": "<0.1%",
    "footer_prefix": "Color reference(s):"
  },
  "states": {
    "below_reference": "attr-low",
    "within_reference": "attr-mid",
    "above_reference": "attr-high",
    "not_comparable": "v8-reference-unavailable"
  },
