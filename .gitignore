# Entornos, dependencias y caches
.venv/
venv/
env/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Credenciales y configuracion propia de la maquina
.env
.env.*
!.env.example
!.env.template
/.aws/
/.ssh/
/.codex/config.toml
/.claude/settings.local.json
/.mcp.json
*.pem
*.key
*.p12
*.pfx

# Presentaciones generadas y evidencia agregada que respalda sus cifras
/output/*
!/output/presentations/
!/output/distribution/
!/output/analysis/

/output/presentations/**
!/output/presentations/**/
!/output/presentations/**/*.html
!/output/presentations/**/*.pdf
!/output/presentations/**/*.pptx
!/output/presentations/**/*.ppt
!/output/presentations/**/*.md
!/output/presentations/**/*.json

/output/distribution/**
!/output/distribution/**/
!/output/distribution/**/*.html
!/output/distribution/**/*.svg
!/output/distribution/*.md
!/output/distribution/*.sql
!/output/distribution/json/*.json
!/output/distribution/v8-backups/**/*.json
!/output/distribution/v8-backups/**/*.md

/output/analysis/*
!/output/analysis/engineering/
/output/analysis/engineering/**
!/output/analysis/engineering/**/
!/output/analysis/engineering/**/*.json
!/output/analysis/engineering/**/*.md
!/output/analysis/engineering/**/*.sql

# Logs, temporales y perfiles de navegador usados al renderizar
.tmp/
.tmp-*/
.tmp_*/
tmp/
.playwright-mcp/
.jupyter-runtime/
chrome-profile/
edge-profile/
*.log
*.tmp
*.bak
~$*
/*.png

# QVoice: conservar documentacion e inventarios agregados, excluir los datos raw
/data/*
!/data/QVoice/
/data/QVoice/*
!/data/QVoice/*.md
!/data/QVoice/qvoice_excel_source_inventory_*.json
!/data/QVoice/qvoice_excel_aggregate_results_*.json

# Insumos binarios y extractos locales; las bases HTML permanecen versionables
/references/tableau/
/references/**/*.xlsx
/references/**/*.xls
/references/**/*.xlsm
/references/**/*.xlsb
/references/**/*.pptx
/references/**/*.ppt
!/references/presentations/source/*.pptx
!/references/presentations/source/*.ppt
/references/**/*.hyper
/references/**/*.twbx
/references/**/*.twbr
/references/**/*.zip

